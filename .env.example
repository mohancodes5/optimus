# Database
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="..."
NEXTAUTH_SECRET="..."
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Production bootstrap (npm run db:seed) — required, no demo accounts
SEED_ADMIN_EMAIL="owner@yourgym.com"
SEED_ADMIN_PASSWORD="use-a-strong-password-min-10-chars"
SEED_ADMIN_NAME="Admin"
# Set true once to wipe members/payments/attendance before bootstrap
# SEED_CLEAR_DEMO="true"

# Twilio SMS — Messaging Service (preferred)
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_from_twilio_console"
TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxx"
SMS_DEFAULT_COUNTRY_CODE="+91"
# Optional fallback instead of Messaging Service:
# TWILIO_PHONE_NUMBER="+1..."

# Email (optional)
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Optimus Fitness <onboarding@resend.dev>"

CRON_SECRET="generate-a-long-random-cron-secret"
