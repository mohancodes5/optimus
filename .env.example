# Supabase PostgreSQL (required on Vercel)
# Use the POOLER host (IPv4). Do NOT use db.xxx.supabase.co on Vercel (IPv6-only).
DATABASE_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# On Vercel: AUTH_URL="https://your-app.vercel.app"
