# Local (SQLite works out of the box — leave as-is for demo)
# DATABASE_URL is optional locally; schema defaults to prisma/dev.db

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ─── PostgreSQL (Supabase or Neon) — for production / Vercel ───
# 1) Change prisma/schema.prisma datasource to:
#      provider  = "postgresql"
#      url       = env("DATABASE_URL")
#      directUrl = env("DIRECT_URL")
# 2) Fill these in, then run: npx prisma db push && npm run db:seed

# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
