# Database
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="..."
NEXTAUTH_SECRET="..."
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Production bootstrap (npm run db:seed) — required, no demo accounts
SEED_ADMIN_EMAIL="owner@yourgym.com"
SEED_ADMIN_PASSWORD="use-a-strong-password-min-10-chars"
SEED_ADMIN_NAME="Admin"
# Set true once to wipe members/payments/attendance before bootstrap
# SEED_CLEAR_DEMO="true"

# Twilio SMS — Messaging Service (preferred for production SMS to any number)
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_from_twilio_console"
TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxx"
SMS_DEFAULT_COUNTRY_CODE="+91"
# Optional fallback instead of Messaging Service:
# TWILIO_PHONE_NUMBER="+1..."

# Twilio WhatsApp (sandbox or production sender)
# Sandbox: whatsapp:+14155238886 — each member must Join the sandbox first
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Leave USE_TEMPLATE=false for sandbox free-form (after join). Set true for approved templates.
TWILIO_WHATSAPP_USE_TEMPLATE="false"
# Content template SID (only needed when USE_TEMPLATE=true)
# TWILIO_WHATSAPP_CONTENT_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_WHATSAPP_CONTENT_SID_WELCOME="HXxxxxxxxx"
# TWILIO_WHATSAPP_CONTENT_SID_REMINDER="HXxxxxxxxx"
# Email (optional)
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Optimus Fitness <onboarding@resend.dev>"

CRON_SECRET="generate-a-long-random-cron-secret"
